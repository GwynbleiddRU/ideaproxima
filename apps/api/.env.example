# Copy to apps/api/.env to override defaults. Full reference: docs/developer/operations.md#configuration

# Database. Default: embedded PGlite in ./.data/pglite (migrated automatically on `npm run dev`).
#   pglite:memory           in-memory (tests)
#   pglite:./.data/pglite   file-backed local development
#   postgres://ideaproxima:ideaproxima@localhost:5433/ideaproxima   docker compose PostgreSQL (`npm run db:up`)
# A real PostgreSQL server is never migrated on startup: run `npm run db:migrate` as an explicit step.
DATABASE_URL=pglite:./.data/pglite

PORT=3000

# Session lifetime in days. Sessions are server-side and revocable.
SESSION_TTL_DAYS=30

# Secure (HTTPS-only) session cookie. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Comma-separated browser origins allowed to call the API with credentials (e.g. a separately hosted frontend).
# CORS_ORIGINS=http://localhost:5173

# Trust X-Forwarded-For for the client address. Enable ONLY behind a reverse proxy you control.
# TRUST_PROXY=false

# Abuse protection (per process, in memory). 0 disables a limit.
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_WRITES_PER_MINUTE=120
# MAX_BODY_BYTES=1048576

# One log line per request.
# LOG_REQUESTS=true
