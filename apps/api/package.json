{
  "name": "@ideaproxima/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ideaproxima API: modular monolith over PostgreSQL (PGlite for local development and tests).",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "metrics:rebuild": "tsx scripts/rebuild-metrics.ts",
    "admin:set-role": "tsx scripts/set-role.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@hono/node-server": "^2.1.8",
    "@ideaproxima/contracts": "0.1.0",
    "@ideaproxima/domain": "0.1.0",
    "@ideaproxima/i18n": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.0",
    "nodemailer": "10.6.1",
    "pino": "10.4.0",
    "postgres": "^3.4.7",
    "prom-client": "15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "13.2.0",
    "tsup": "^9.0.0"
  }
}
